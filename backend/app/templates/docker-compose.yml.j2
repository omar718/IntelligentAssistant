services:
  {{ service_name }}:
    image: {{ image }}:{{ version }}
    working_dir: /workspace
    volumes:
      - {{ project_path }}:/workspace
    ports:
      - "{{ port }}:{{ port }}"
    environment:
{% for key, value in env_vars.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    command: {{ start_command }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ port }}"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s